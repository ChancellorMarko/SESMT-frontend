# demo: dados sintéticos em memória no navegador; api: consome a API externa.
VITE_API_MODE=demo
# No modo api, prefira esta base com API_PROXY_TARGET. URL absoluta também precisa incluir /api/v1.
VITE_API_BASE_URL=/api/v1
# Apenas para desenvolvimento integrado, destino do proxy Vite. Nunca colocar segredos.
API_PROXY_TARGET=http://127.0.0.1:5047
# Origens HTTPS adicionais autorizadas para URLs temporárias de download (separadas por vírgula).
# A origem da API já é permitida. Em demo, URLs blob são exclusivamente locais.
VITE_DOWNLOAD_ALLOWED_ORIGINS=
# Habilitar em modo api somente após homologar os contratos de convite de conta.
# O modo demo permite explorar o primeiro acesso com dados sintéticos.
VITE_ACCOUNT_INVITATIONS_ENABLED=false
